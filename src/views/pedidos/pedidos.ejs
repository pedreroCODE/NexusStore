<%- include('../partials/header') %>
<% const adminMode = typeof isAdmin !== 'undefined' && isAdmin; %>

<div class="row">
    <div class="col-12">
        <h2 class="mb-4 fw-bold"><%= adminMode ? 'Todos os Pedidos' : 'Meus Pedidos' %></h2>
        <% if (pedidoSucesso) { %>
            <div class="alert alert-success border-0 shadow-sm mb-4" role="alert">
                <strong><%= pedidoSucesso %></strong>
            </div>
        <% } %>
        <% if (avisoPedidos) { %>
            <div class="alert alert-warning border-0 shadow-sm mb-4" role="alert">
                <strong><%= avisoPedidos %></strong>
            </div>
        <% } %>
        <% if (adminMode) { %>
            <div class="alert alert-info border-0 shadow-sm mb-4" role="alert">
                <strong>Modo admin:</strong> você vê todos os pedidos cadastrados.
            </div>
            <form class="row g-2 mb-4" method="GET" action="/pedidos">
                <div class="col-md-9">
                    <input
                        type="text"
                        name="q"
                        class="form-control form-control-lg"
                        placeholder="Buscar por pedido, cliente, e-mail ou status"
                        value="<%= typeof buscaPedidos !== 'undefined' ? buscaPedidos : '' %>">
                </div>
                <div class="col-md-3 d-grid">
                    <button type="submit" class="btn btn-dark btn-lg">Pesquisar</button>
                </div>
            </form>
        <% } %>
    </div>
    
    <!-- Lista de Histórico de Pedidos -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="py-3 px-4">Nº do Pedido</th>
                            <th class="py-3">Data da Compra</th>
                            <th class="py-3">Valor Total</th>
                            <th class="py-3">Status</th>
                            <th class="py-3 text-center">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (pedidos && pedidos.length > 0) { %>
                            <% pedidos.forEach(p => { %>
                                <tr class="<%= (pedidoSelecionado && pedidoSelecionado.id_pedido === p.id_pedido) ? 'table-success-light border-start border-success border-3' : '' %>">
                                    <td class="px-4 py-3 fw-bold">#<%= p.id_pedido %></td>
                                    <td class="py-3"><%= p.data_compra %></td>
                                    <td class="py-3 fw-semibold">R$ <%= p.valor_total.toFixed(2).replace('.', ',') %></td>
                                    <td class="py-3">
                                        <span class="badge bg-secondary rounded-pill px-3 py-2"><%= p.status_pedido %></span>
                                    </td>
                                    <td class="py-3 text-center">
                                        <div class="d-flex flex-wrap gap-2 justify-content-center">
                                            <a href="/pedidos?id=<%= p.id_pedido %>" class="btn btn-sm btn-outline-secondary">Ver Detalhes</a>
                                            <% if (adminMode) { %>
                                                <form method="POST" action="/admin/pedidos/<%= p.id_pedido %>/status" class="d-inline-flex gap-1 align-items-center">
                                                    <select name="status_pedido" class="form-select form-select-sm" style="width: 140px;">
                                                        <% ['Recebido', 'Em Transporte', 'Entregue', 'Cancelado'].forEach(status => { %>
                                                            <option value="<%= status %>" <%= p.status_pedido === status ? 'selected' : '' %>><%= status %></option>
                                                        <% }) %>
                                                    </select>
                                                    <button type="submit" class="btn btn-sm btn-primary">Salvar</button>
                                                </form>
                                                <form method="POST" action="/admin/pedidos/<%= p.id_pedido %>/excluir" onsubmit="return confirm('Tem certeza que deseja excluir este pedido?')">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">Ainda não realizaste nenhum pedido.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Detalhes do Pedido Selecionado -->
    <div class="col-lg-5">
        <% if (pedidoSelecionado) { %>
            <div class="card shadow-sm border-0 p-4">
                <h4 class="fw-bold mb-2">Pedido #<%= pedidoSelecionado.id_pedido %></h4>
                <p class="text-muted small mb-4">Realizado em <%= pedidoSelecionado.data_compra %></p>
                
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-4">
                        <thead class="table-light">
                            <tr>
                                <th>Produto</th>
                                <th class="text-center">Qtd</th>
                                <th class="text-end">Preço</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% pedidoSelecionado.itens.forEach(item => { %>
                                <tr>
                                    <td class="py-2 fw-semibold text-secondary"><%= item.nome %></td>
                                    <td class="py-2 text-center"><%= item.quantidade_comprada %></td>
                                    <td class="py-2 text-end">R$ <%= (item.preco_congelado * item.quantidade_comprada).toFixed(2).replace('.', ',') %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <div class="border-top pt-3 d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-dark">Total do Pedido:</span>
                    <h4 class="fw-bold text-success mb-0">R$ <%= pedidoSelecionado.valor_total.toFixed(2).replace('.', ',') %></h4>
                </div>

                <div class="mt-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted">Pagamento</div>
                        <div class="fw-bold text-uppercase"><%= pedidoSelecionado.metodo_pagamento || '---' %></div>
                    </div>
                </div>

                <% if (adminMode) { %>
                    <div class="border-top mt-4 pt-4">
                        <h6 class="fw-bold mb-3">Ações do Admin</h6>
                        <form method="POST" action="/admin/pedidos/<%= pedidoSelecionado.id_pedido %>/status" class="mb-3">
                            <label class="form-label">Alterar status</label>
                            <div class="d-flex gap-2">
                                <select name="status_pedido" class="form-select">
                                    <% ['Recebido', 'Em Transporte', 'Entregue', 'Cancelado'].forEach(status => { %>
                                        <option value="<%= status %>" <%= pedidoSelecionado.status_pedido === status ? 'selected' : '' %>><%= status %></option>
                                    <% }) %>
                                </select>
                                <button type="submit" class="btn btn-primary">Atualizar</button>
                            </div>
                        </form>
                        <form method="POST" action="/admin/pedidos/<%= pedidoSelecionado.id_pedido %>/excluir" onsubmit="return confirm('Excluir este pedido e todos os itens?')">
                            <button type="submit" class="btn btn-outline-danger">Excluir Pedido</button>
                        </form>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="card shadow-sm border-0 p-4 text-center text-muted py-5">
                <p class="mb-0">Seleciona um pedido ao lado para visualizar os detalhes.</p>
            </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>
