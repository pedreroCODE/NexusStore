<%- include('../partials/header') %>

<div class="bg-white p-4 rounded-3 shadow-sm border">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold text-dark mb-1">Produtos</h3>
            <p class="text-muted small mb-0">Gerencie todos os produtos do seu e-commerce com facilidade.</p>
        </div>
        <a href="/produtos/novo" class="btn btn-success px-3 py-2 fw-semibold d-flex align-items-center">
            <i class="bi bi-plus-lg me-2"></i>  Novo Produto
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="text-muted small" style="font-size: 0.85rem;">
                    <th scope="col" style="width: 80px;">ID</th>
                    <th scope="col">Nome do Produto</th>
                    <th scope="col">Categoria</th>
                    <th scope="col">Preço (R$)</th>
                    <th scope="col">Estoque Atual</th>
                    <th scope="col" class="text-center" style="width: 120px;">Ações</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof produtos !== 'undefined' && produtos.length > 0) { %>
                    <% produtos.forEach(produto => { %>
                        <tr style="font-size: 0.9rem;">
                            <td class="fw-bold text-secondary">#<%= produto.id_produto %></td>
                            <td class="text-dark fw-medium"><%= produto.nome %></td>
                            <td class="text-secondary"><%= produto.categoria_nome || 'Sem Categoria' %></td>
                            <td class="fw-bold"><%= Number(produto.preco).toFixed(2).replace('.', ',') %></td>
                            <td>
                                <span class="badge <%= produto.quantidade_estoque > 0 ? 'bg-success text-success' : 'bg-danger text-danger' %> bg-opacity-10 px-2.5 py-1.5 rounded">
                                    <%= produto.quantidade_estoque %> unidades
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <a href="/produtos/editar/<%= produto.id_produto %>" class="btn btn-sm btn-success p-1 px-2" style="background-color: #0c572e; border: none;" title="Editar">
                                        <i class="bi bi-pencil-fill" style="font-size: 0.8rem; color: #fff;"></i>
                                    </a>
                                    <form action="/produtos/excluir/<%= produto.id_produto %>" method="POST" onsubmit="return confirm('Deseja realmente excluir este produto?')" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-danger p-1 px-2" title="Excluir">
                                            <i class="bi bi-trash-fill" style="font-size: 0.8rem;"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Nenhum produto cadastrado no momento.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/footer') %>
