<%- include('../partials/header') %>

<div class="bg-white p-4 rounded-3 shadow-sm border">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold text-dark mb-1">Produtos</h3>
            <p class="text-muted small mb-0">Gerencie todos os produtos do seu e-commerce com facilidade.</p>
        </div>
        <a href="/produtos/novo" class="btn btn-success px-3 py-2 fw-semibold d-flex align-items-center">
            <i class="bi bi-plus-lg me-2"></i> + Novo Produto
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="text-muted small" style="font-size: 0.85rem;">
                    <th scope="col" style="width: 80px;">ID</th>
                    <th scope="col">Nome do Produto</th>
                    <th scope="col">Categoria</th>
                    <th scope="col">Preço (R$)</th>
                    <th scope="col">Estoque Atual</th>
                    <th scope="col" class="text-center" style="width: 120px;">Ações</th>
                </tr>
            </thead>
            <tbody>
                <tr style="font-size: 0.9rem;">
                    <td class="fw-bold text-secondary">1</td>
                    <td class="text-dark fw-medium">Smartphone Galaxy A54</td>
                    <td class="text-secondary">Eletrônicos</td>
                    <td class="fw-bold">1.900,00</td>
                    <td>
                        <span class="badge bg-success bg-opacity-10 text-success px-2.5 py-1.5 rounded">
                            15 unidades
                        </span>
                    </td>
                    <td class="text-center">
                        <div class="d-flex justify-content-center gap-1">
                            <a href="/produtos/editar/1" class="btn btn-sm btn-success p-1 px-2" style="background-color: #0c572e; border: none;">
                                <i class="bi bi-pencil-fill" style="font-size: 0.8rem; color: #fff;"></i>
                            </a>
                            <form action="/produtos/deletar/1" method="POST" onsubmit="return confirm('Deseja realmente excluir este produto?')" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger p-1 px-2">
                                    <i class="bi bi-trash-fill" style="font-size: 0.8rem;"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/footer') %>