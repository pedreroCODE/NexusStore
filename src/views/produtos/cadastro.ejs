<%- include('../partials/header') %>

<div class="bg-white p-4 rounded-3 shadow-sm border mx-auto" style="max-width: 850px;">
    <h4 class="fw-bold text-dark mb-4"><%= produto ? 'Editar Produto' : 'Cadastro de Produto' %></h4>

    <form action="/produtos/salvar" method="POST">
        <input type="hidden" name="id_produto" value="<%= produto ? produto.id_produto : '' %>">
        
        <div class="row g-4">
            
            <div class="col-md-7 d-flex flex-column gap-3">
                <div>
                    <label class="form-label">Nome do Produto</label>
                    <input type="text" class="form-control" name="nome" placeholder="Digite o nome do produto" value="<%= produto ? produto.nome : '' %>" required>
                </div>

                <div>
                    <label class="form-label">Descrição do Produto</label>
                    <textarea class="form-control" name="descricao_produto" rows="5" placeholder="Escreva os detalhes técnicos do hardware..."><%= produto ? produto.descricao_produto : '' %></textarea>
                </div>

                <div>
                    <label class="form-label fw-bold">Categoria</label>
                    <select class="form-select" name="id_categoria" required>
                        <option value="" disabled <%= !produto ? 'selected' : '' %>>Selecione a categoria</option>
                        
                        <% if (typeof categorias !== 'undefined' && categorias.length > 0) { %>
                            <% categorias.forEach(cat => { %>
                                <option value="<%= cat.id_categoria %>" <%= (produto && produto.id_categoria === cat.id_categoria) ? 'selected' : '' %>>
                                    <%= cat.nome %>
                                </option>
                            <% }) %>
                        <% } else { %>
                            <option value="" disabled>Nenhuma categoria cadastrada</option>
                        <% } %>
                    </select>
                </div>
            </div>

            <div class="col-md-5 d-flex flex-column gap-3">
                <div>
                    <label class="form-label">Preço de Venda (R$)</label>
                    <input type="number" step="0.01" class="form-control" name="preco" placeholder="0.00" value="<%= produto ? produto.preco : '' %>" required>
                </div>

                <div>
                    <label class="form-label">Quantidade em Estoque</label>
                    <input type="number" class="form-control" name="quantidade_estoque" placeholder="0" value="<%= produto ? produto.quantidade_estoque : '' %>" required>
                </div>

                <div>
                    <label class="form-label">Imagem do Produto (URL)</label>
                    <input type="url" class="form-control mb-2" name="url_foto" placeholder="https://link-da-imagem.com/foto.jpg" value="<%= produto ? produto.url_foto : '' %>">
                    <div class="border border-dashed rounded-3 d-flex align-items-center justify-content-center text-muted bg-light overflow-hidden" style="height: 115px; border-style: dashed !important;">
                        <% if (produto && produto.url_foto) { %>
                            <img src="<%= produto.url_foto %>" style="max-height: 100%; max-width: 100%; object-fit: contain;">
                        <% } else { %>
                            <span class="small text-center p-2"><i class="bi bi-image fs-4 d-block mb-1"></i> Pré-visualização da imagem</span>
                        <% } %>
                    </div>
                </div>
            </div>

        </div>

        <div class="d-flex justify-content-end mt-4 border-top pt-3">
            <a href="/produtos" class="btn btn-outline-secondary px-4 py-2 me-2">Cancelar</a>
            <button type="submit" class="btn btn-success px-4 py-2 fw-semibold d-flex align-items-center" style="background-color: #00753c; border: none;">
                <i class="bi bi-floppy-fill me-2"></i> <%= produto ? 'Salvar Alterações' : 'Salvar Produto' %>
            </button>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>