<%- include('../partials/header') %>

<div class="bg-white p-4 rounded-3 shadow-sm border mx-auto" style="max-width: 850px;">
    <h4 class="fw-bold text-dark mb-4">Cadastro / Edição de Produto</h4>

    <form action="/produtos/salvar" method="POST">
        <div class="row g-4">
            
            <div class="col-md-7 d-flex flex-column gap-3">
                <div>
                    <label class="form-label">Nome do Produto</label>
                    <input type="text" class="form-control" name="nome" placeholder="Digite o nome do produto" required>
                </div>

                <div>
                    <label class="form-label">Descrição do Produto</label>
                    <textarea class="form-control" name="descricao_produto" rows="5" placeholder="Escreva os detalhes técnicos do hardware..."></textarea>
                </div>

                <div>
                    <label class="form-label">Categoria</label>
                    <select class="form-select" name="id_categoria" required>
                        <option value="" disabled selected>Selecione a categoria</option>
                        <option value="1">Eletrônicos</option>
                        <option value="2">Hardware & Componentes</option>
                    </select>
                </div>
            </div>

            <div class="col-md-5 d-flex flex-column gap-3">
                <div>
                    <label class="form-label">Preço de Venda (R$)</label>
                    <input type="number" step="0.01" class="form-control" name="preco" placeholder="0.00" required>
                </div>

                <div>
                    <label class="form-label">Quantidade em Estoque</label>
                    <input type="number" class="form-control" name="quantidade_estoque" placeholder="0" required>
                </div>

                <div>
                    <label class="form-label">Imagem do Produto (URL)</label>
                    <input type="url" class="form-control mb-2" name="url_foto" placeholder="https://link-da-imagem.com/foto.jpg">
                    <div class="border border-dashed rounded-3 d-flex align-items-center justify-content-center text-muted bg-light" style="height: 115px; border-style: dashed !important;">
                        <span class="small text-center p-2"><i class="bi bi-image fs-4 d-block mb-1"></i> Pré-visualização da imagem</span>
                    </div>
                </div>
            </div>

        </div>

        <div class="d-flex justify-content-end mt-4 border-top pt-3">
            <button type="submit" class="btn btn-success px-4 py-2 fw-semibold d-flex align-items-center" style="background-color: #00753c; border: none;">
                <i class="bi bi-floppy-fill me-2"></i> Salvar Produto
            </button>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>