<%- include('partials/header') %>

<div class="bg-white p-4 p-md-5 rounded-3 shadow-sm border mx-auto" style="max-width: 900px;">
    <h3 class="fw-bold text-dark mb-4">Minha Conta</h3>

    <h5 class="text-dark fw-semibold mb-4" style="letter-spacing: -0.2px;">Olá, João da Silva. Seus dados cadastrais.</h5>

    <form action="/minha-conta/atualizar" method="POST">
        
        <p class="text-muted small fw-bold mb-2 text-uppercase tracking-wider" style="font-size: 0.75rem;">Dados Pessoais</p>
        
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label">Nome Completo</label>
                <input type="text" class="form-control" name="nome" placeholder="Digite seu nome completo" value="João da Silva" required>
            </div>
            <div class="col-md-6">
                <label class="form-label">E-mail</label>
                <input type="email" class="form-control" name="email" placeholder="nome@exemplo.com" value="joao@exemplo.com" required readonly style="background-color: #e9ecef; opacity: 0.85;">
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">Telefone</label>
                <input type="text" class="form-control" name="telefone" placeholder="(00) 00000-0000">
            </div>
            <div class="col-md-6">
                <label class="form-label">CPF</label>
                <input type="text" class="form-control" name="cpf" placeholder="000.000.000-00" required>
            </div>
        </div>

        <p class="text-muted small fw-bold mb-2 text-uppercase tracking-wider" style="font-size: 0.75rem;">Endereço</p>
        
        <div class="row g-3 mb-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">CEP</label>
                <div class="input-group">
                    <input type="number" class="form-control" name="cep" placeholder="CEP" value="86000000">
                </div>
            </div>
            <div class="col-md-2 ps-0">
                <button type="button" class="btn text-white w-100 fw-semibold" style="background-color: #0b4625; padding: 0.52rem 0.5rem; font-size: 0.85rem; border: none;">Buscar CEP</button>
            </div>
            <div class="col-md-5">
                <label class="form-label">Rua</label>
                <input type="text" class="form-control" name="rua" placeholder="Rua" value="Avenida Principal">
            </div>
            <div class="col-md-2">
                <label class="form-label">Número</label>
                <input type="number" class="form-control" name="numero" placeholder="Nº" value="100">
            </div>
        </div>

        <div class="row g-3 mb-5">
            <div class="col-md-4">
                <label class="form-label">Bairro</label>
                <input type="text" class="form-control" name="bairro" placeholder="Bairro" value="Centro">
            </div>
            <div class="col-md-5">
                <label class="form-label">Cidade</label>
                <input type="text" class="form-control" name="cidade" placeholder="Cidade" value="Londrina">
            </div>
            <div class="col-md-3">
                <label class="form-label">Estado</label>
                <select class="form-select px-2" name="estado">
                    <option value="PR" selected>PR</option>
                    <option value="SP">SP</option>
                    <option value="SC">SC</option>
                    <option value="RS">RS</option>
                </select>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center border-top pt-4">
            <button type="submit" class="btn text-white px-4 py-2 fw-semibold d-flex align-items-center rounded-2" style="background-color: #0c572e; border: none; font-size: 0.9rem;">
                <i class="bi bi-arrow-left-right me-2"></i> Salvar Alterações
            </button>
            
            <button type="button" class="btn btn-danger px-4 py-2 fw-semibold d-flex align-items-center rounded-2" style="font-size: 0.9rem;" onsubmit="return confirm('Tem certeza que deseja excluir sua conta permanentemente?')">
                <i class="bi bi-trash3-fill me-2"></i> Excluir minha conta
            </button>
        </div>
    </form>
</div>

<%- include('partials/footer') %>