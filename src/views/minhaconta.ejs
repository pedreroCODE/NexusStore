<%- include('partials/header') %>

<div class="bg-white p-4 rounded-3 shadow-sm border mx-auto" style="max-width: 850px;">
    <h4 class="fw-bold text-dark mb-1">Minha Conta</h4>
    <p class="text-muted small mb-4">Olá, <strong><%= cliente.nome %></strong>. Veja e gerencie seus dados cadastrais.</p>

    <form action="/admin/clientes/salvar" method="POST">
        <input type="hidden" name="id_cliente" value="<%= cliente.id_cliente %>">

        <h6 class="text-success fw-bold small text-uppercase mb-3" style="color: #0b4625 !important;">Dados Pessoais</h6>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label small text-muted">Nome Completo</label>
                <input type="text" class="form-control" name="nome" value="<%= cliente.nome %>" required>
            </div>
            <div class="col-md-6">
                <label class="form-label small text-muted">E-mail</label>
                <input type="email" class="form-control bg-light" name="email" value="<%= cliente.email %>" readonly required>
            </div>
            <div class="col-md-6">
                <label class="form-label small text-muted">Telefone</label>
                <input type="text" class="form-control" name="telefone" value="<%= cliente.telefone || '' %>" placeholder="(00) 00000-0000">
            </div>
            <div class="col-md-6">
                <label class="form-label small text-muted">CPF</label>
                <input type="text" class="form-control" name="cpf" value="<%= cliente.cpf || '' %>" placeholder="000.000.000-00">
            </div>
        </div>

        <h6 class="text-success fw-bold small text-uppercase mb-3" style="color: #0b4625 !important;">Endereço de Entrega</h6>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label small text-muted">CEP</label>
                <div class="input-group">
                    <input type="text" class="form-control" name="cep" id="cep" value="<%= cliente.cep || '' %>" placeholder="86000000">
                    <button class="btn btn-nexus small" type="button" style="font-size: 0.85rem;">Buscar CEP</button>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label small text-muted">Rua</label>
                <input type="text" class="form-control" name="rua" value="<%= cliente.rua || '' %>" placeholder="Avenida Principal">
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Número</label>
                <input type="text" class="form-control" name="numero" value="<%= cliente.numero || '' %>" placeholder="100">
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted">Bairro</label>
                <input type="text" class="form-control" name="bairro" value="<%= cliente.bairro || '' %>" placeholder="Centro">
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted">Cidade</label>
                <input type="text" class="form-control" name="cidade" value="<%= cliente.cidade || '' %>" placeholder="Londrina">
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted">Estado</label>
                <input type="text" class="form-control" name="estado" value="<%= cliente.estado || '' %>" placeholder="PR" maxlength="2">
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4 border-top pt-3">
            <button type="submit" class="btn btn-success px-4 py-2 fw-semibold d-flex align-items-center" style="background-color: #0b4625; border: none;">
                <i class="bi bi-check-circle me-2"></i> Salvar Alterações
            </button>
            
            <% if (cliente.email !== 'admin@nexus.local') { %>
                <button type="button" class="btn btn-danger px-4 py-2 fw-semibold" onclick="excluirMinhaConta('<%= cliente.id_cliente %>')">
                    <i class="bi bi-trash3 me-2"></i> Excluir minha conta
                </button>
            <% } %>
        </div>
    </form>
</div>

<script>
    function excluirMinhaConta(id) {
        if (confirm('Tem certeza absoluta que deseja excluir permanentemente a sua conta e todo o seu histórico de nossa loja?')) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/admin/clientes/excluir/' + id;
            document.body.appendChild(form);
            form.submit();
        }
    }
</script>

<%- include('partials/footer') %>