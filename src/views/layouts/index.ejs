<%- include('../partials/header') %>
<div class="row g-4">
    <div class="col-md-2">
        <h5 class="fw-bold text-muted small text-uppercase mb-3" style="letter-spacing: 1px;">Categorias</h5>
        <div class="list-group list-group-flush shadow-sm rounded-3 overflow-hidden border">
            <a href="#" class="list-group-item list-group-item-action border-0 py-2 fs-6 fw-medium bg-white text-success border-start border-success border-3">Eletrônicos</a>
        </div>
    </div>

    <div class="col-md-10">
        <h4 class="fw-bold text-dark mb-4">Destaques</h4>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            
            <% if (typeof produtos !== 'undefined' && produtos.length > 0) { %>
                <% produtos.forEach(produto => { %>
                    <div class="col">
                        <div class="card h-100 card-product bg-white">
                            <div class="p-4 text-center bg-white rounded-top">
                                <img src="<%= produto.url_foto || 'https://images.unsplash.com/photo-1531403009284-440f080d1e12?w=400' %>" 
                                     alt="<%= produto.nome %>" 
                                     class="img-fluid rounded" 
                                     style="max-height: 140px; object-fit: contain;">
                            </div>
                            
                            <div class="card-body p-3 d-flex flex-column text-center border-top bg-white">
                                <h6 class="text-secondary small mb-1"><%= produto.nome %></h6>
                                <h5 class="fw-bold text-dark mb-3">R$ <%= Number(produto.preco).toFixed(2).replace('.', ',') %></h5>
                                
                                <form action="/carrinho/adicionar" method="POST" class="mt-auto">
                                    <input type="hidden" name="id_produto" value="<%= produto.id_produto %>">
                                    <input type="hidden" name="nome" value="<%= produto.nome %>">
                                    <input type="hidden" name="preco" value="<%= produto.preco %>">
                                    <input type="hidden" name="url_foto" value="<%= produto.url_foto || '' %>">
                                    <input type="hidden" name="quantidade" value="1">
                                    
                                    <% if (produto.quantidade_estoque > 0) { %>
                                        <button type="submit" class="btn btn-nexus w-100 py-2 rounded-3 fw-medium" style="font-size: 0.85rem;">
                                            <i class="bi bi-cart-plus"></i> Adicionar ao Carrinho
                                        </button>
                                    <% } else { %>
                                        <button type="button" class="btn btn-secondary w-100 py-2 rounded-3 fw-medium" style="font-size: 0.85rem;" disabled>
                                            Esgotado
                                        </button>
                                    <% } %>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-12 text-center py-5 text-muted">
                    <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
                    <p>Nenhum produto cadastrado ou disponível no estoque no momento.</p>
                </div>
            <% } %>

        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const container = document.getElementById("headerContainer");
        if (container) {
            container.classList.replace("justify-content-end", "justify-content-between");
            const search = document.createElement("div");
            search.className = "input-group"; search.style.maxWidth = "450px";
            search.innerHTML = `<span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span><input type="text" class="form-control bg-light border-start-0" placeholder="Buscar produtos...">`;
            container.insertBefore(search, container.firstChild);
        }
    });
</script>
<%- include('../partials/footer') %>