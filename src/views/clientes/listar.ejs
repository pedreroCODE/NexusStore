<%- include('../partials/header') %>

<div class="bg-white p-4 rounded-3 shadow-sm border">
    <div class="mb-4">
        <h3 class="fw-bold text-dark mb-1">Clientes Cadastrados</h3>
        <p class="text-muted small mb-0">Gerencie e visualize todos os usuários registrados no banco de dados.</p>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="text-muted small" style="font-size: 0.85rem;">
                    <th scope="col" style="width: 80px;">ID</th>
                    <th scope="col">Nome do Cliente</th>
                    <th scope="col">E-mail</th>
                    <th scope="col">Telefone</th>
                    <th scope="col">Localização</th>
                    <th scope="col" class="text-center" style="width: 120px;">Ações</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof clientes !== 'undefined' && clientes.length > 0) { %>
                    <% clientes.forEach(cliente => { %>
                        <tr style="font-size: 0.9rem;">
                            <td class="fw-bold text-secondary">#<%= cliente.id_cliente %></td>
                            <td class="text-dark fw-medium">
                                <%= cliente.nome %> 
                                <% if (cliente.email === 'admin@nexus.local') { %>
                                    <i class="bi bi-star-fill text-warning ms-1" title="Administrador Master"></i>
                                <% } %>
                            </td>
                            <td class="text-secondary"><%= cliente.email %></td>
                            <td class="text-secondary"><%= cliente.telefone || '(00) 00000-0000' %></td>
                            <td>
                                <% if (cliente.cidade && cliente.estado) { %>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1 rounded">
                                        <i class="bi bi-geo-alt-fill me-1"></i> <%= cliente.cidade %> - <%= cliente.estado %>
                                    </span>
                                <% } else { %>
                                    <span class="text-muted fst-italic small">Não preenchido</span>
                                <% } %>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <a href="/admin/clientes/editar/<%= cliente.id_cliente %>" class="btn btn-sm btn-success p-1 px-2" style="background-color: #0c572e; border: none;" title="Editar Cadastro">
                                        <i class="bi bi-pencil-fill" style="font-size: 0.8rem; color: #fff;"></i>
                                    </a>
                                    
                                    <form action="/admin/clientes/excluir/<%= cliente.id_cliente %>" method="POST" onsubmit="return confirm('Deseja realmente remover este cliente do sistema?')" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-danger p-1 px-2" title="Remover Usuário">
                                            <i class="bi bi-trash-fill" style="font-size: 0.8rem;"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Nenhum cliente encontrado no banco de dados.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/footer') %>